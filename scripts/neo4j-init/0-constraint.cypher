CREATE CONSTRAINT IF NOT EXISTS FOR (u:User) REQUIRE u.psqlId IS UNIQUE;
CREATE CONSTRAINT IF NOT EXISTS FOR (g:Group) REQUIRE g.psqlChatId IS UNIQUE;
CREATE CONSTRAINT IF NOT EXISTS FOR (a:Artists) REQUIRE a.id IS UNIQUE;
CREATE CONSTRAINT IF NOT EXISTS FOR (s:Song) REQUIRE s.id IS UNIQUE;
CREATE CONSTRAINT IF NOT EXISTS FOR (gen:Genre) REQUIRE gen.id IS UNIQUE;

